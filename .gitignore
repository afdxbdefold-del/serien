# ============================================
# SERIEN.DE - Git Ignore
# ============================================

# Node modules
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Lock files (zu groß für Git)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Next.js
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Environment variables
.env
.env*.local
.env.production
.env.development

# Prisma
*.db
*.db-journal

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Testing
coverage/
.nyc_output/

# Temporary files
*.tmp
.cache/

# Vercel
.vercel

# Python (old backend)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/

# Archives
backend-old/
frontend-old/

# Emergent
.emergent/
test_reports/
memory/

# Documentation (keep in repo)
!*.md
!*.txt
-e 
