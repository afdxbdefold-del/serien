# Core application
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
REVALIDATE_SECRET=

# One-time admin bootstrap (`node scripts/create-admin.js`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Content and AI
OPENAI_API_KEY=
TMDB_API_KEY=
NEWS_INTERVAL_HOURS=1
NEWS_LIMIT=10
DISCOVER_BULK_CONCURRENCY=2
DISCOVER_BULK_LIMIT=20
EUR_PER_USD=0.92
HEADLINE_OPINION_KILLER=true
HEADLINE_REWRITE_LOOP=true
USE_PROCESSED_IMAGES=true
ENABLE_FAITHFUL=true

# Cloudflare R2 media storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
NEXT_PUBLIC_R2_URL=

# Legacy Vercel Blob migration support
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_URL=
NEXT_PUBLIC_BLOB_URL=

# Scheduled jobs
CRON_SECRET=

# Web push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_API_SECRET=
PUSH_ALLOWED_HOSTS=

# Trailer pipeline
RAPIDAPI_KEY=
RAPIDAPI_KEY_BACKUP=
YOUTUBE_COOKIES_PATH=

# Distribution and indexing
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN_EXPIRES_AT=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_INDEXING_BASE_URL=https://indexing.googleapis.com/v3

# Legacy Emergent compatibility only. Remove after the remaining media and
# authentication routes have been migrated; never use this as a fallback.
EMERGENT_LLM_KEY=
