generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model article_persons {
  articleId String
  personId  String
  articles  articles @relation(fields: [articleId], references: [id], onDelete: Cascade)
  persons   persons  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([articleId, personId])
}

model article_qa {
  id            String   @id
  articleId     String   @unique
  questions     Json
  schemaEnabled Boolean  @default(true)
  generatedAt   DateTime @default(now())
  updatedAt     DateTime
  articles      articles @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model article_series {
  articleId String
  seriesId  Int
  position  Int      @default(0)
  createdAt DateTime @default(now())
  articles  articles @relation(fields: [articleId], references: [id], onDelete: Cascade)
  series    series   @relation(fields: [seriesId], references: [tmdbId], onDelete: Cascade)

  @@id([articleId, seriesId])
  @@index([articleId])
  @@index([seriesId])
}

model articles {
  id                        String                      @id
  slug                      String                      @unique
  title                     String
  excerpt                   String?
  contentHtml               String
  heroLocalUrl              String?
  heroVideoUrl              String?
  tmdbId                    Int?
  tmdbType                  String                      @default("tv")
  tmdbBackdropPath          String?
  tmdbPosterPath            String?
  heroImageUrl              String?
  ogImageUrl                String?
  cardImageUrl              String?
  imageAttribution          String                      @default("TMDB")
  streamer                  String?
  category                  String?
  tags                      String[]
  authorId                  String
  publishedAt               DateTime?
  updatedAt                 DateTime
  createdAt                 DateTime                    @default(now())
  status                    String                      @default("draft")
  readingTime               Int?
  confidence                Float?
  sourceUrl                 String?                     @unique
  sourcePublishedAt         DateTime?
  contentType               String?
  primarySeriesId           Int                         @default(119051)
  publishMode               String                      @default("DISCOVER")
  wasBedeutetDasText        String?
  trailerLocalUrl           String?
  cardImagePath             String?
  heroImagePath             String?
  isRankingArticle          Boolean                     @default(false)
  metaDescription           String?
  ogImagePath               String?
  article_persons           article_persons[]
  article_qa                article_qa?
  article_series            article_series[]
  users                     users                       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  series                    series                      @relation(fields: [primarySeriesId], references: [tmdbId])
  comments                  comments[]
  discover_audits           discover_audits?
  discover_score_dashboards discover_score_dashboards[]
  headline_comparisons      headline_comparisons?

  @@index([primarySeriesId])
  @@index([publishedAt])
  @@index([slug])
}

model characters {
  id                  String   @id
  slug                String   @unique
  name                String
  seriesTmdbId        Int
  tmdbCharacterId     String?
  actorTmdbId         Int?
  shortDescription    String?
  whoIsContent        String?
  roleInSeriesContent String?
  importanceContent   String?
  appearancesContent  String?
  qaContent           Json?
  status              String?
  firstAppearance     String?
  seasons             String?
  metaTitle           String?
  metaDescription     String?
  publishStatus       String   @default("draft")
  articleMentions     Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime
  imageUrl            String?
  orderIndex          Int?
  persons             persons? @relation(fields: [actorTmdbId], references: [tmdbId])
  series              series   @relation(fields: [seriesTmdbId], references: [tmdbId], onDelete: Cascade)

  @@index([actorTmdbId])
  @@index([seriesTmdbId])
  @@index([slug])
}

model comments {
  id             String     @id
  articleId      String
  userId         String
  parentId       String?
  content        String
  status         String     @default("pending")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  articles       articles   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  comments       comments?  @relation("commentsTocomments", fields: [parentId], references: [id], onDelete: Cascade)
  other_comments comments[] @relation("commentsTocomments")
  users          users      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model discover_audits {
  id             String   @id
  articleId      String   @unique
  discoverScore  Int
  discoverMode   String
  passed         Boolean
  breakdownJson  Json
  wordCount      Int
  hasHero        Boolean
  hasByline      Boolean
  freshnessHours Int
  aiRiskScore    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  articles       articles @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([discoverScore])
  @@index([passed])
}

model discover_score_dashboards {
  id               String   @id
  articleId        String
  timestamp        DateTime @default(now())
  pipelineVersion  String   @default("serien_pipeline_v1")
  headlineMetrics  Json
  contentMetrics   Json
  freshnessMetrics Json
  imageMetrics     Json
  trustMetrics     Json
  discoverScore    Float
  finalVerdict     String
  primaryBlockers  String[]
  improvementHints String[]
  articles         articles @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([timestamp])
}

model follows {
  userId       String
  tmdbSeriesId Int
  createdAt    DateTime @default(now())
  series       series   @relation(fields: [tmdbSeriesId], references: [tmdbId], onDelete: Cascade)
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tmdbSeriesId])
}

model headline_comparisons {
  id                    String   @id
  articleId             String   @unique
  headline_original     String
  headline_rewritten    String?
  antiAiScore_original  Int?
  antiAiScore_rewritten Int?
  headline_delta        Int?
  status                String   @default("NO_REWRITE")
  createdAt             DateTime @default(now())
  articles              articles @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([createdAt])
  @@index([status])
}

model notifications {
  id          String   @id
  userId      String
  type        String
  entityId    String
  payloadJson Json?
  seen        Boolean  @default(false)
  createdAt   DateTime @default(now())
  users       users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seen])
}

model persons {
  id              String            @id
  tmdbId          Int               @unique
  slug            String            @unique
  name            String
  biography       String?
  profilePath     String?
  knownFor        String?
  birthDate       DateTime?
  birthPlace      String?
  popularity      Float?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  article_persons article_persons[]
  characters      characters[]
}

model redirects {
  fromPath  String   @id @unique
  toPath    String
  type      Int      @default(301)
  createdAt DateTime @default(now())
}

model series {
  tmdbId              Int              @id @unique
  title               String
  slug                String           @unique
  overview            String?
  posterLocalUrl      String?
  backdropLocalUrl    String?
  status              String?
  firstAirDate        DateTime?
  genres              String[]
  networks            String[]
  tmdbData            Json?
  updatedAt           DateTime
  createdAt           DateTime         @default(now())
  backdropPath        String?
  genresJson          Json?
  name                String?
  networksJson        Json?
  originalName        String?
  posterPath          String?
  tmdbType            String           @default("tv")
  cast                Json?
  crew                Json?
  episodeRunTime      Int[]
  inProduction        Boolean?
  keywords            String[]
  lastAirDate         DateTime?
  numberOfEpisodes    Int?
  numberOfSeasons     Int?
  originalLanguage    String?
  popularity          Float?
  productionCompanies String[]
  productionCountries String[]
  seasons             Json?
  spokenLanguages     String[]
  tagline             String?
  trailers            Json?
  type                String?
  voteAverage         Float?
  voteCount           Int?
  currentStatus       String?
  lastNewsDate        DateTime?
  lastSeasonNumber    Int?
  statusDescription   String?
  statusLastUpdate    DateTime?
  extendedOverview    String?
  discoverIntro       String?
  discoverNewsContext String?
  discoverQA          Json?
  discoverStatus      String?
  backdrops           Json?
  article_series      article_series[]
  articles            articles[]
  characters          characters[]
  follows             follows[]
}

model users {
  id                  String          @id
  name                String?
  email               String          @unique
  password            String?
  createdAt           DateTime        @default(now())
  image               String?
  role                String          @default("user")
  bio                 String?
  expertise           String[]        @default([])
  favoriteStreamers   String[]        @default([])
  onboardingCompleted Boolean         @default(false)
  articles            articles[]
  comments            comments[]
  follows             follows[]
  notifications       notifications[]
}
