/// User Question Radar — stores every generated run so we can compute
/// trend deltas (today vs 7d vs 30d) for the same (topic, question) key.
model radar_runs {
  id         String   @id @default(cuid())
  topic      String
  topicKey   String   // normalized topic (lowercase, dashed) for cross-run joins
  boost      Boolean  @default(false)
  items      Json     // full array of question items as stored (scores, headlines etc.)
  createdAt  DateTime @default(now())

  @@index([topicKey, createdAt])
  @@index([createdAt])
}

/// Content queue / saved topics from the radar.
/// type = 'article' | 'reel' | 'carousel' | 'faq' | 'saved'
model content_queue {
  id              String   @id @default(cuid())
  type            String   // article / reel / carousel / faq / saved
  status          String   @default("pending") // pending / done / dismissed
  topic           String
  question        String
  headline        String?
  category        String?
  intentType      String?
  recommendedFormat String?
  seoScore        Int?
  discoverScore   Int?
  socialScore     Int?
  monetizationScore Int?
  competitionScore Int?
  freshness       String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type, status, createdAt])
  @@index([topic])
}


/// Series / topic blocklist — admin-managed exclusion list for the content pipeline.
/// Matches on ANY of: tmdbIds (post-TMDB), urlPatterns (substring, source url), titleKeywords (substring, title).
model blocklist_entries {
