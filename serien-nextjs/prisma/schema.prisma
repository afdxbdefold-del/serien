/// Daily Top-10 rankings per streaming platform, country, and type.
/// Populated by cron (1×/day). We keep daily snapshots so we can compute
/// trends (position delta week-over-week) and build "now trending" lists.
model streamer_rankings {
  id            String   @id @default(cuid())
  platform      String   // "hbo-max" | "netflix" | "disney-plus" | …
  country       String   // ISO lower-case, e.g. "germany"
  type          String   // "tv" | "movie"
  date          DateTime @db.Date
  rank          Int      // 1..10
  title         String   // exact title as listed
  slug          String   // external slug (for reference only)
  tmdbId        Int?     // resolved against our TMDB series table
  tmdbMatched   Boolean  @default(false)
  // Opportunistic poster/backdrop cache: set at ingest time when the series
  // isn't in our local `series` table but TMDB returned a match. Lets the
  // UI render covers even before the main pipeline onboards the series.
  posterPath    String?
  backdropPath  String?
  createdAt     DateTime @default(now())

  @@unique([platform, country, type, date, rank])
  @@index([platform, country, type, date])
  @@index([tmdbId, date])
}



/// Sitemap-Prewarm Audit-Log.
/// Jede Pipeline ruft nach Publish /api/internal/revalidate-sitemap auf, um den
/// Vercel Edge Cache für /news-sitemap.xml zu invalidieren. Wir persistieren
/// das Ergebnis hier, damit das Admin-"Sitemap Health"-Widget zeigen kann, ob
/// der letzte Prewarm erfolgreich war und wie schnell er reagiert hat.
model sitemap_prewarm_log {
  id           String   @id @default(cuid())
  articleSlug  String?
  success      Boolean
  statusCode   Int?
  errorMessage String?  @db.Text
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model facebook_post_log {
  id           String   @id @default(cuid())
  articleSlug  String
  fbPostId     String?
  success      Boolean
  statusCode   Int?
  message      String?  @db.Text
  errorMessage String?  @db.Text
  trigger      String   @default("auto") // "auto" | "manual"
  createdAt    DateTime @default(now())

  @@index([articleSlug])
  @@index([createdAt])
}

/// v5.7 Hallucination Watch: logged every time the Body-Fact-Verifier
/// blocks an article from DISCOVER because of a streamer claim that
/// contradicts TMDB DE provider data. Powers the admin watchlist widget
/// so editors can see which sources are systematically lying about
/// German streaming availability.
model hallucination_log {
  id              String   @id @default(cuid())
  articleId       String?
  articleSlug     String?
  articleTitle    String?  @db.Text
  sourceUrl       String?  @db.Text
  sourceHost      String?
  kind            String   // "positive_claim" | "negative_de_claim"
  claimedStreamer String?
  actualDeProviders String[] @default([])
  excerpt         String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([sourceHost])
  @@index([kind])
}

