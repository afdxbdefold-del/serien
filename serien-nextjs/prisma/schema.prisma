generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      String   @default("user")
  image     String?
  createdAt DateTime @default(now())
  articles      Article[]
  comments      Comment[]
  follows       Follow[]
  notifications Notification[]
  @@map("users")
}

model Series {
  tmdbId          Int      @id @unique
  title           String
  slug            String   @unique
  overview        String?  @db.Text
  posterLocalUrl  String?
  backdropLocalUrl String?
  status          String?
  firstAirDate    DateTime?
  genres          String[]
  networks        String[]
  tmdbData        Json?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  articles Article[]
  follows  Follow[]
  @@map("series")
}

model Article {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String?   @db.Text
  contentHtml   String    @db.Text
  heroLocalUrl  String?
  heroVideoUrl  String?
  
  // TMDB Image Pipeline Fields
  tmdbId        Int?
  tmdbType      String    @default("tv") // "tv" | "movie"
  tmdbBackdropPath String?
  tmdbPosterPath   String?
  heroImageUrl     String?  // our proxied URL
  ogImageUrl       String?  // our proxied URL
  cardImageUrl     String?  // our proxied URL
  imageAttribution String   @default("TMDB")
  
  streamer      String?
  category      String?
  tags          String[]
  tmdbSeriesId  Int?
  seriesId      String?   // NEW: FK to Series.id
  authorId      String
  publishedAt   DateTime?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
  status        String    @default("draft")
  readingTime   Int?
  confidence    Float?
  sourceUrl     String?   @unique  // NEW: Track source URL
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  series   Series?   @relation(fields: [tmdbSeriesId], references: [tmdbId], onDelete: SetNull)
  seriesNew Series? @relation("ArticleToSeries", fields: [seriesId], references: [id], onDelete: SetNull)
  comments Comment[]
  @@index([slug])
  @@index([publishedAt])
  @@index([seriesId])
  @@index([tmdbId])
  @@map("articles")
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  parentId  String?
  content   String   @db.Text
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentThread")
  @@index([articleId])
  @@map("comments")
}

model Follow {
  userId       String
  tmdbSeriesId Int
  createdAt    DateTime @default(now())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [tmdbSeriesId], references: [tmdbId], onDelete: Cascade)
  @@id([userId, tmdbSeriesId])
  @@map("follows")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  entityId    String
  payloadJson Json?
  seen        Boolean  @default(false)
  createdAt   DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, seen])
  @@map("notifications")
}

model Redirect {
  fromPath  String @id @unique
  toPath    String
  type      Int    @default(301)
  createdAt DateTime @default(now())
  @@map("redirects")
}
