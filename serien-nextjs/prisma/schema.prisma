generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model article_persons {
  articleId String
  personId  String
  articles  articles @relation(fields: [articleId], references: [id], onDelete: Cascade)
  persons   persons  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([articleId, personId])
}

model article_qa {
  id            String   @id
  articleId     String   @unique
  questions     Json
  schemaEnabled Boolean  @default(true)
  headingType   String?  @default("default") // episode, season, finale, ending, default
  generatedAt   DateTime @default(now())
  updatedAt     DateTime
  articles      articles @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model article_series {
  articleId String
  seriesId  Int
  position  Int      @default(0)
  createdAt DateTime @default(now())
  articles  articles @relation(fields: [articleId], references: [id], onDelete: Cascade)
  series    series   @relation(fields: [seriesId], references: [tmdbId], onDelete: Cascade)

  @@id([articleId, seriesId])
  @@index([articleId])
  @@index([seriesId])
}

model articles {
  id                        String                      @id
  slug                      String                      @unique
  title                     String
  excerpt                   String?
  contentHtml               String
  heroLocalUrl              String?
  heroVideoUrl              String?
  tmdbId                    Int?
  tmdbType                  String                      @default("tv")
  tmdbBackdropPath          String?
  tmdbPosterPath            String?
  heroImageUrl              String?
  ogImageUrl                String?
  cardImageUrl              String?
  imageAttribution          String                      @default("TMDB")
  streamer                  String?
  category                  String?
  tags                      String[]
  authorId                  String
  publishedAt               DateTime?
  updatedAt                 DateTime
  createdAt                 DateTime                    @default(now())
  status                    String                      @default("draft")
  readingTime               Int?
  confidence                Float?
  sourceUrl                 String?                     @unique
  sourcePublishedAt         DateTime?
  contentType               String?
  primarySeriesId           Int?
  publishMode               String                      @default("DISCOVER")
  wasBedeutetDasText        String?
  trailerLocalUrl           String?
  cardImagePath             String?
  heroImagePath             String?
  isRankingArticle          Boolean                     @default(false)
  metaDescription           String?
  ogImagePath               String?
  isTrending                Boolean                     @default(false)
  isBreaking                Boolean                     @default(false)
  article_persons           article_persons[]
  article_qa                article_qa?
  article_series            article_series[]
  users                     users                       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  series                    series?                     @relation(fields: [primarySeriesId], references: [tmdbId])
  comments                  comments[]
  discover_audits           discover_audits?
  discover_score_dashboards discover_score_dashboards[]
  headline_comparisons      headline_comparisons?

  @@index([primarySeriesId])
  @@index([publishedAt])
  @@index([slug])
}

model characters {
  id                  String   @id
  slug                String   @unique
  name                String
  seriesTmdbId        Int
  tmdbCharacterId     String?
  actorTmdbId         Int?
  shortDescription    String?
  whoIsContent        String?
  roleInSeriesContent String?
  importanceContent   String?
  appearancesContent  String?
  qaContent           Json?
  status              String?
  firstAppearance     String?
  seasons             String?
  metaTitle           String?
  metaDescription     String?
  publishStatus       String   @default("draft")
  articleMentions     Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime
  imageUrl            String?
  orderIndex          Int?
  persons             persons? @relation(fields: [actorTmdbId], references: [tmdbId])
  series              series   @relation(fields: [seriesTmdbId], references: [tmdbId], onDelete: Cascade)

  @@index([actorTmdbId])
  @@index([seriesTmdbId])
  @@index([slug])
}

model comments {
  id             String     @id
  articleId      String
  userId         String
  parentId       String?
  content        String
  status         String     @default("pending")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  articles       articles   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  comments       comments?  @relation("commentsTocomments", fields: [parentId], references: [id], onDelete: Cascade)
  other_comments comments[] @relation("commentsTocomments")
  users          users      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model discover_audits {
  id             String   @id
  articleId      String   @unique
  discoverScore  Int
  discoverMode   String
  passed         Boolean
  breakdownJson  Json
  wordCount      Int
  hasHero        Boolean
  hasByline      Boolean
  freshnessHours Int
  aiRiskScore    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  articles       articles @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([discoverScore])
  @@index([passed])
}

model discover_score_dashboards {
  id               String   @id
  articleId        String
  timestamp        DateTime @default(now())
  pipelineVersion  String   @default("serien_pipeline_v1")
  headlineMetrics  Json
  contentMetrics   Json
  freshnessMetrics Json
  imageMetrics     Json
  trustMetrics     Json
  discoverScore    Float
  finalVerdict     String
  primaryBlockers  String[]
  improvementHints String[]
  articles         articles @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([timestamp])
}

model follows {
  userId       String
  tmdbSeriesId Int
  createdAt    DateTime @default(now())
  series       series   @relation(fields: [tmdbSeriesId], references: [tmdbId], onDelete: Cascade)
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tmdbSeriesId])
}

model headline_comparisons {
  id                    String   @id
  articleId             String   @unique
  headline_original     String
  headline_rewritten    String?
  antiAiScore_original  Int?
  antiAiScore_rewritten Int?
  headline_delta        Int?
  status                String   @default("NO_REWRITE")
  createdAt             DateTime @default(now())
  articles              articles @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([createdAt])
  @@index([status])
}

model notifications {
  id          String   @id
  userId      String
  type        String
  entityId    String
  payloadJson Json?
  seen        Boolean  @default(false)
  createdAt   DateTime @default(now())
  users       users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seen])
}

model persons {
  id              String            @id
  tmdbId          Int               @unique
  slug            String            @unique
  name            String
  biography       String?
  profilePath     String?
  knownFor        String?
  birthDate       DateTime?
  birthPlace      String?
  popularity      Float?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  article_persons article_persons[]
  characters      characters[]
}

model redirects {
  fromPath  String   @id @unique
  toPath    String
  type      Int      @default(301)
  createdAt DateTime @default(now())
}

model series {
  tmdbId              Int                 @id @unique
  title               String
  slug                String              @unique
  overview            String?
  posterLocalUrl      String?
  backdropLocalUrl    String?
  status              String?
  firstAirDate        DateTime?
  genres              String[]
  networks            String[]
  tmdbData            Json?
  updatedAt           DateTime
  createdAt           DateTime            @default(now())
  backdropPath        String?
  genresJson          Json?
  name                String?
  networksJson        Json?
  originalName        String?
  posterPath          String?
  tmdbType            String              @default("tv")
  cast                Json?
  crew                Json?
  episodeRunTime      Int[]
  inProduction        Boolean?
  keywords            String[]
  lastAirDate         DateTime?
  numberOfEpisodes    Int?
  numberOfSeasons     Int?
  originalLanguage    String?
  popularity          Float?
  productionCompanies String[]
  productionCountries String[]
  seasons             Json?
  spokenLanguages     String[]
  tagline             String?
  trailers            Json?
  type                String?
  voteAverage         Float?
  voteCount           Int?
  currentStatus       String?
  lastNewsDate        DateTime?
  lastSeasonNumber    Int?
  statusDescription   String?
  statusLastUpdate    DateTime?
  extendedOverview    String?
  discoverIntro       String?
  discoverNewsContext String?
  discoverQA          Json?
  discoverStatus      String?
  backdrops           Json?
  article_series      article_series[]
  articles            articles[]
  characters          characters[]
  follows             follows[]
  upcoming_episodes   upcoming_episodes[]
}

model users {
  id                  String          @id
  name                String?
  email               String          @unique
  password            String?
  createdAt           DateTime        @default(now())
  image               String?
  role                String          @default("user")
  favoriteStreamers   String[]        @default([])
  onboardingCompleted Boolean         @default(false)
  bio                 String?
  expertise           String[]        @default([])
  articles            articles[]
  comments            comments[]
  follows             follows[]
  notifications       notifications[]
}

model upcoming_episodes {
  id            String   @id @default(cuid())
  seriesId      Int
  seriesName    String
  seriesSlug    String
  seasonNumber  Int
  episodeNumber Int
  episodeName   String?
  airDate       DateTime
  overview      String?
  stillPath     String?
  network       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  series        series   @relation(fields: [seriesId], references: [tmdbId], onDelete: Cascade)

  @@unique([seriesId, seasonNumber, episodeNumber])
  @@index([airDate])
  @@index([network])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_subscriptions")
}

model streaming_releases {
  id            String   @id @default(cuid())
  tmdbId        Int
  provider      String
  date          DateTime @db.Date
  name          String
  overview      String?
  posterPath    String?
  backdropPath  String?
  firstAirDate  DateTime?
  voteAverage   Float?
  releaseType   String   @default("new_episode")
  fetchedAt     DateTime @default(now())
  
  @@unique([tmdbId, provider, date], name: "tmdbId_provider_date")
  @@index([date])
  @@index([provider])
}

model ad_slots {
  id          String   @id @default(cuid())
  position    String   @unique // mobile_top, above_intro, below_intro, in_content, below_author, below_series_info, above_similar_news, above_footer
  name        String   // Anzeigename für Admin
  description String?  // Beschreibung der Position
  adClient    String   @default("ca-pub-8583619451045805")
  adSlot      String   // Die Slot-ID von AdSense
  width       Int      // Breite in px
  height      Int      // Höhe in px
  isActive    Boolean  @default(true)
  mobileOnly  Boolean  @default(false)
  desktopOnly Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model analytics_events {
  id          String   @id @default(cuid())
  sessionId   String   // Unique session identifier
  visitorId   String   // Persistent visitor ID (cookie)
  event       String   // page_view, click, scroll, etc.
  path        String   // URL path
  referrer    String?  // Where they came from
  userAgent   String?
  country     String?
  city        String?
  device      String?  // mobile, tablet, desktop
  browser     String?
  os          String?
  duration    Int?     // Time on page in seconds
  scrollDepth Int?     // Max scroll percentage
  articleId   String?  // If on article page
  seriesId    String?  // If on series page
  metadata    Json?    // Extra data
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([visitorId])
  @@index([path])
  @@index([event])
}

model analytics_sessions {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  visitorId   String
  startedAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  pageViews   Int      @default(1)
  entryPage   String
  exitPage    String?
  referrer    String?
  userAgent   String?
  country     String?
  device      String?
  browser     String?
  isActive    Boolean  @default(true)

  @@index([lastSeenAt])
  @@index([isActive])
  @@index([visitorId])
}

model trending_topics {
  id          String   @id @default(cuid())
  query       String   // Original search query
  title       String   // Display title
  category    String   // series, film, other
  growth      String?  // +650%, Ausreißer, etc.
  tmdbId      Int?     // Matched TMDB series ID
  seriesSlug  String?  // Link to internal series
  articleSlugs String[] // Generated articles for this trend
  articleId   String?  // Main article generated for this trend
  date        DateTime
  fetchedAt   DateTime @default(now())
  processed   Boolean  @default(false)
  processedAt DateTime? // When the article was generated

  @@unique([query, date])
  @@index([date])
  @@index([category])
  @@index([processed])
}

// ══════════════════════════════════════════════════════════════════════════
// YOUTUBE CHANNEL TRACKING
// ══════════════════════════════════════════════════════════════════════════

model youtube_channels {
  id              String   @id @default(cuid())
  channelId       String   @unique // YouTube channel ID (e.g., UCZqkRFHEWPkph0HFxeakEgQ)
  name            String   // Display name (e.g., "Netflix Deutschland")
  url             String   // Channel URL
  thumbnailUrl    String?  // Channel thumbnail
  description     String?  // Channel description
  subscriberCount Int?     // Subscriber count (optional)
  isActive        Boolean  @default(true) // Whether to check for new videos
  checkInterval   Int      @default(60) // Check interval in minutes
  lastCheckedAt   DateTime? // Last time we checked for new videos
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  videos          youtube_videos[]
  
  @@index([isActive])
  @@index([lastCheckedAt])
}

model youtube_videos {
  id              String   @id @default(cuid())
  videoId         String   @unique // YouTube video ID (e.g., 0LbMUSw7B8s)
  channelId       String   // Reference to youtube_channels.channelId
  title           String   // Video title
  description     String?  // Video description
  thumbnailUrl    String?  // Video thumbnail (maxres or high)
  duration        String?  // Video duration (e.g., "PT2M30S")
  publishedAt     DateTime // When the video was published on YouTube
  viewCount       Int?     // View count (optional)
  likeCount       Int?     // Like count (optional)
  
  // Processing status
  processed       Boolean  @default(false)
  processedAt     DateTime?
  articleId       String?  // Generated article ID
  articleSlug     String?  // Generated article slug
  
  // Content extraction
  transcript      String?  // Video transcript/subtitles (if available)
  tags            String[] // Video tags
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  channel         youtube_channels @relation(fields: [channelId], references: [channelId], onDelete: Cascade)
  
  @@index([channelId])
  @@index([publishedAt])
  @@index([processed])
}

// ══════════════════════════════════════════════════════════════════════════
// PIPELINE RUNS & LOGS
// ══════════════════════════════════════════════════════════════════════════

model pipeline_runs {
  id              String   @id @default(cuid())
  pipeline        String   // 'p3-trends', 'p4-youtube', 'pipeline-v2', 'cron-news'
  trigger         String   // 'cron', 'manual', 'api'
  status          String   // 'running', 'success', 'partial', 'failed'
  
  // Input
  inputQuery      String?  // Search term / trend query
  inputVideoId    String?  // YouTube video ID
  inputSource     String?  // Source URL or identifier
  
  // Output
  articleId       String?  // Generated article ID
  articleSlug     String?  // Generated article slug
  articleTitle    String?  // Generated article title
  
  // Metrics
  sourcesFound    Int      @default(0)  // Number of sources scraped
  wordsCollected  Int      @default(0)  // Total words from sources
  factsExtracted  Int      @default(0)  // Facts extracted
  antiAiScore     Int?     // Anti-AI filter score (0-100)
  
  // Timing
  durationMs      Int?     // Total duration in milliseconds
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  
  // Error tracking
  errorMessage    String?  // Error message if failed
  errorStep       String?  // Which step failed (scrape, llm, save, etc.)
  
  // Debug info (JSON)
  debugLog        String?  // JSON array of log messages
  metadata        String?  // Additional JSON metadata
  
  createdAt       DateTime @default(now())
  
  @@index([pipeline])
  @@index([status])
  @@index([startedAt])
  @@index([articleId])
}
