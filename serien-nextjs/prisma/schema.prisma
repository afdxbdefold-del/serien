model blocked_visitors {
  id              String   @id
  blockKey        String   @unique
  reason          String
  signals         Json?
  blockedAt       DateTime @default(now())
  expiresAt       DateTime
  manualWhitelist Boolean  @default(false)

  @@index([blockKey])
  @@index([expiresAt])
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ad_slots {
  id          String   @id
  position    String   @unique
  name        String
  description String?
  // 'adsense' (legacy: render <ins class="adsbygoogle">) or
  // 'custom'  (render arbitrary HTML / JS code from customHtmlJson)
  provider    String   @default("adsense")
  adClient    String   @default("ca-pub-8583619451045805")
  adSlot      String
  // JSON array of variants for custom-HTML mode (rotation supported).
  // Each variant: { label: string, html: string, weight: number, isActive: boolean }
  customHtmlJson String? @db.Text
  // 'random' | 'weighted' | 'first'  — how to pick a variant on each render
  rotationMode String   @default("random")
  width       Int
  height      Int
  isActive    Boolean  @default(true)
  mobileOnly  Boolean  @default(false)
  desktopOnly Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

/// Observability for Google Indexing API calls.
/// Captures every push attempt (publish/update/manual) so the admin dashboard
/// can verify whether Google is actually receiving notifications and whether
/// the API key/auth flow is healthy.
model google_indexing_api_logs {
  id              String   @id @default(cuid())
  articleId       String?
  url             String
  eventType       String   // 'publish' | 'update' | 'manual'
  requestPayload  String?  // JSON of the body we sent
  responseStatus  Int?     // HTTP status from Google
  responseBody    String?  // truncated response (max ~2000 chars)
  success         Boolean
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([articleId])
  @@index([success, createdAt])
}

model analytics_events {
  id          String   @id
  sessionId   String
  visitorId   String
  event       String
  path        String
  referrer    String?
  userAgent   String?
  country     String?
  city        String?
  device      String?
  browser     String?
  os          String?
  duration    Int?
  scrollDepth Int?
  articleId   String?
  seriesId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([event])
  @@index([path])
  @@index([sessionId])
  @@index([visitorId])
}

model analytics_sessions {
  id              String   @id
