generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      String   @default("user")
  image     String?
  createdAt DateTime @default(now())
  
  // Onboarding preferences
  favoriteStreamers String[] @default([])
  onboardingCompleted Boolean @default(false)
  
  articles      Article[]
  comments      Comment[]
  follows       Follow[]
  notifications Notification[]
  @@map("users")
}

model Series {
  tmdbId          Int      @id @unique
  tmdbType        String   @default("tv")
  title           String
  slug            String   @unique
  name            String?  // Localized name (de-DE)
  originalName    String?  // Original name from TMDB
  overview        String?  @db.Text
  tagline         String?
  
  // Images
  posterLocalUrl  String?
  backdropLocalUrl String?
  posterPath      String?  // TMDB path
  backdropPath    String?  // TMDB path
  
  // Metadata
  status          String?
  type            String?   // Scripted, Documentary, etc.
  firstAirDate    DateTime?
  lastAirDate     DateTime?
  numberOfSeasons Int?
  numberOfEpisodes Int?
  episodeRunTime  Int[]
  inProduction    Boolean?
  
  // Ratings & Popularity
  voteAverage     Float?
  voteCount       Int?
  popularity      Float?
  
  // Genres & Networks
  genres          String[]
  genresJson      Json?    // Full genre objects
  networks        String[]
  networksJson    Json?    // Full network objects
  
  // Production
  productionCompanies String[]
  productionCountries String[]
  spokenLanguages     String[]
  originalLanguage    String?
  
  // Cast & Crew (Top 20 each)
  cast            Json?     // [{name, character, profile_path}]
  crew            Json?     // [{name, job, department, profile_path}]
  
  // Seasons
  seasons         Json?     // [{season_number, episode_count, air_date, poster_path}]
  
  // Videos (Trailers)
  trailers        Json?     // [{key (YouTube ID), name, site, type}]
  
  // Keywords
  keywords        String[]
  
  // Series Status Tracker
  currentStatus        String?   // "RUNNING" | "RENEWED" | "ENDED" | "ON_HOLD" | "UNCLEAR"
  statusDescription    String?
  statusLastUpdate     DateTime?
  lastSeasonNumber     Int?
  lastNewsDate         DateTime?
  
  // Full TMDB Data (backup)
  tmdbData        Json?
  
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  
  // Many-to-Many Relations
  articleSeries   ArticleSeries[]
  primaryArticles Article[]         @relation("PrimarySeries")
  
  follows         Follow[]
  @@map("series")
}

model Article {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String?   @db.Text
  contentHtml   String    @db.Text
  heroLocalUrl  String?
  heroVideoUrl  String?
  
  // TMDB Image Pipeline Fields
  tmdbId        Int?
  tmdbType      String    @default("tv") // "tv" | "movie"
  tmdbBackdropPath String?
  tmdbPosterPath   String?
  heroImageUrl     String?  // our proxied URL
  ogImageUrl       String?  // our proxied URL
  cardImageUrl     String?  // our proxied URL
  imageAttribution String   @default("TMDB")
  
  // Content Classification
  contentType   String?   // SINGLE_SERIES_NEWS | MULTI_SERIES_EDITORIAL
  
  // Primary Series (REQUIRED, temp default for migration)
  primarySeriesId Int      @default(119051)
  primarySeries   Series   @relation("PrimarySeries", fields: [primarySeriesId], references: [tmdbId], onDelete: Restrict)
  
  // Many-to-Many: Related Series (max 7)
  articleSeries   ArticleSeries[]
  
  streamer      String?
  category      String?
  tags          String[]
  authorId      String
  publishedAt   DateTime?
  sourcePublishedAt DateTime?  // Original source publication date (internal only)
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
  status        String    @default("draft")
  readingTime   Int?
  confidence    Float?
  sourceUrl     String?   @unique  // Track source URL
  publishMode   String    @default("DISCOVER") // "DISCOVER" | "SEARCH_ONLY" | "DRAFT"
  wasBedeutetDasText String? // "Was bedeutet das?" Box (max 2 Sätze, max 35 Wörter)
  
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  discoverDashboards DiscoverScoreDashboard[]
  headlineComparison HeadlineComparison?
  
  @@index([slug])
  @@index([publishedAt])
  @@index([primarySeriesId])
  @@map("articles")
}

model DiscoverScoreDashboard {
  id              String   @id @default(cuid())
  articleId       String
  timestamp       DateTime @default(now())
  pipelineVersion String   @default("serien_pipeline_v1")
  
  // Metrics (stored as JSON)
  headlineMetrics  Json
  contentMetrics   Json
  freshnessMetrics Json
  imageMetrics     Json
  trustMetrics     Json
  
  // Aggregation
  discoverScore    Float
  finalVerdict     String // "DISCOVER_OK" | "SEARCH_ONLY" | "SKIPPED"
  primaryBlockers  String[]
  improvementHints String[]
  
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  
  @@index([articleId])
  @@index([timestamp])
  @@map("discover_score_dashboards")
}

model HeadlineComparison {
  id                     String   @id @default(cuid())
  articleId              String   @unique
  headline_original      String
  headline_rewritten     String?
  antiAiScore_original   Int?
  antiAiScore_rewritten  Int?
  headline_delta         Int?
  status                 String   @default("NO_REWRITE") // "IMPROVED" | "NEUTRAL" | "WORSE" | "NO_REWRITE"
  createdAt              DateTime @default(now())
  
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  
  @@index([articleId])
  @@index([status])
  @@index([createdAt])
  @@map("headline_comparisons")
}

model ArticleSeries {
  articleId String
  seriesId  Int
  position  Int      @default(0)  // For ordering related series
  createdAt DateTime @default(now())
  
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  series  Series  @relation(fields: [seriesId], references: [tmdbId], onDelete: Cascade)
  
  @@id([articleId, seriesId])
  @@index([articleId])
  @@index([seriesId])
  @@map("article_series")
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  parentId  String?
  content   String   @db.Text
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentThread")
  @@index([articleId])
  @@map("comments")
}

model Follow {
  userId       String
  tmdbSeriesId Int
  createdAt    DateTime @default(now())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [tmdbSeriesId], references: [tmdbId], onDelete: Cascade)
  @@id([userId, tmdbSeriesId])
  @@map("follows")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  entityId    String
  payloadJson Json?
  seen        Boolean  @default(false)
  createdAt   DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, seen])
  @@map("notifications")
}

model Redirect {
  fromPath  String @id @unique
  toPath    String
  type      Int    @default(301)
  createdAt DateTime @default(now())
  @@map("redirects")
}


model DiscoverAudit {
  id            String   @id @default(cuid())
  articleId     String   @unique
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  discoverScore  Int
  discoverMode   String   // "DISCOVER" | "SEARCH_ONLY" | "DRAFT" | "SKIP_PUBLISH"
  passed         Boolean

  // Breakdown as JSON (signals + evidence)
  breakdownJson  Json

  // Convenience fields for dashboard sorting
  wordCount      Int
  hasHero        Boolean
  hasByline      Boolean
  freshnessHours Int
  aiRiskScore    Int

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([passed])
  @@index([discoverScore])
  @@index([createdAt])
  @@map("discover_audits")
}
