generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  name                String?
  email               String         @unique
  password            String?
  createdAt           DateTime       @default(now())
  image               String?
  role                String         @default("user")
  favoriteStreamers   String[]       @default([])
  onboardingCompleted Boolean        @default(false)
  articles            Article[]
  comments            Comment[]
  follows             Follow[]
  notifications       Notification[]

  @@map("users")
}

model Series {
  tmdbId              Int             @id @unique
  title               String
  slug                String          @unique
  overview            String?
  posterLocalUrl      String?
  backdropLocalUrl    String?
  status              String?
  firstAirDate        DateTime?
  genres              String[]
  networks            String[]
  tmdbData            Json?
  updatedAt           DateTime        @updatedAt
  createdAt           DateTime        @default(now())
  backdropPath        String?
  genresJson          Json?
  name                String?
  networksJson        Json?
  originalName        String?
  posterPath          String?
  tmdbType            String          @default("tv")
  cast                Json?
  crew                Json?
  episodeRunTime      Int[]
  inProduction        Boolean?
  keywords            String[]
  lastAirDate         DateTime?
  numberOfEpisodes    Int?
  numberOfSeasons     Int?
  originalLanguage    String?
  popularity          Float?
  productionCompanies String[]
  productionCountries String[]
  seasons             Json?
  spokenLanguages     String[]
  tagline             String?
  trailers            Json?
  type                String?
  voteAverage         Float?
  voteCount           Int?
  currentStatus       String?
  lastNewsDate        DateTime?
  lastSeasonNumber    Int?
  statusDescription   String?
  statusLastUpdate    DateTime?
  articleSeries       ArticleSeries[]
  primaryArticles     Article[]       @relation("PrimarySeries")
  follows             Follow[]

  @@map("series")
}

model Article {
  id                 String                   @id @default(cuid())
  slug               String                   @unique
  title              String
  excerpt            String?
  contentHtml        String
  heroLocalUrl       String?
  heroVideoUrl       String?
  tmdbId             Int?
  tmdbType           String                   @default("tv")
  tmdbBackdropPath   String?
  tmdbPosterPath     String?
  heroImageUrl       String?
  ogImageUrl         String?
  cardImageUrl       String?
  imageAttribution   String                   @default("TMDB")
  streamer           String?
  category           String?
  tags               String[]
  authorId           String
  publishedAt        DateTime?
  updatedAt          DateTime                 @updatedAt
  createdAt          DateTime                 @default(now())
  status             String                   @default("draft")
  readingTime        Int?
  confidence         Float?
  sourceUrl          String?                  @unique
  sourcePublishedAt  DateTime?
  contentType        String?
  primarySeriesId    Int                      @default(119051)
  publishMode        String                   @default("DISCOVER")
  wasBedeutetDasText String?
  trailerLocalUrl    String?
  articleSeries      ArticleSeries[]
  author             User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  primarySeries      Series                   @relation("PrimarySeries", fields: [primarySeriesId], references: [tmdbId])
  comments           Comment[]
  discoverAudit      DiscoverAudit?
  discoverDashboards DiscoverScoreDashboard[]
  headlineComparison HeadlineComparison?

  @@index([slug])
  @@index([publishedAt])
  @@index([primarySeriesId])
  @@map("articles")
  articleQA          ArticleQA?
}

model ArticleQA {
  id             String   @id @default(cuid())
  articleId      String   @unique
  questions      Json     // [{question: string, answer: string, factual: boolean}]
  schemaEnabled  Boolean  @default(true)
  generatedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_qa")
}

model DiscoverScoreDashboard {
  id               String   @id @default(cuid())
  articleId        String
  timestamp        DateTime @default(now())
  pipelineVersion  String   @default("serien_pipeline_v1")
  headlineMetrics  Json
  contentMetrics   Json
  freshnessMetrics Json
  imageMetrics     Json
  trustMetrics     Json
  discoverScore    Float
  finalVerdict     String
  primaryBlockers  String[]
  improvementHints String[]
  article          Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([timestamp])
  @@map("discover_score_dashboards")
}

model HeadlineComparison {
  id                    String   @id @default(cuid())
  articleId             String   @unique
  headline_original     String
  headline_rewritten    String?
  antiAiScore_original  Int?
  antiAiScore_rewritten Int?
  headline_delta        Int?
  status                String   @default("NO_REWRITE")
  createdAt             DateTime @default(now())
  article               Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([status])
  @@index([createdAt])
  @@map("headline_comparisons")
}

model ArticleSeries {
  articleId String
  seriesId  Int
  position  Int      @default(0)
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [tmdbId], onDelete: Cascade)

  @@id([articleId, seriesId])
  @@index([articleId])
  @@index([seriesId])
  @@map("article_series")
}

model Comment {
  id        String    @id @default(cuid())
  articleId String
  userId    String
  parentId  String?
  content   String
  status    String    @default("pending")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentThread")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("comments")
}

model Follow {
  userId       String
  tmdbSeriesId Int
  createdAt    DateTime @default(now())
  series       Series   @relation(fields: [tmdbSeriesId], references: [tmdbId], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tmdbSeriesId])
  @@map("follows")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  entityId    String
  payloadJson Json?
  seen        Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seen])
  @@map("notifications")
}

model Redirect {
  fromPath  String   @id @unique
  toPath    String
  type      Int      @default(301)
  createdAt DateTime @default(now())

  @@map("redirects")
}

model DiscoverAudit {
  id             String   @id @default(cuid())
  articleId      String   @unique
  discoverScore  Int
  discoverMode   String
  passed         Boolean
  breakdownJson  Json
  wordCount      Int
  hasHero        Boolean
  hasByline      Boolean
  freshnessHours Int
  aiRiskScore    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([passed])
  @@index([discoverScore])
  @@index([createdAt])
  @@map("discover_audits")
}
