generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ad_slots {
  id          String   @id
  position    String   @unique
  name        String
  description String?
  adClient    String   @default("ca-pub-8583619451045805")
  adSlot      String
  width       Int
  height      Int
  isActive    Boolean  @default(true)
  mobileOnly  Boolean  @default(false)
  desktopOnly Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model analytics_events {
  id          String   @id
  sessionId   String
  visitorId   String
  event       String
  path        String
  referrer    String?
  userAgent   String?
  country     String?
  city        String?
  device      String?
  browser     String?
  os          String?
  duration    Int?
  scrollDepth Int?
  articleId   String?
  seriesId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([event])
  @@index([path])
  @@index([sessionId])
  @@index([visitorId])
}

model analytics_sessions {
  id         String   @id
  sessionId  String   @unique
  visitorId  String
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  pageViews  Int      @default(1)
  entryPage  String
  exitPage   String?
  referrer   String?
  userAgent  String?
  country    String?
  device     String?
  browser    String?
  isActive   Boolean  @default(true)

  @@index([isActive])
  @@index([lastSeenAt])
  @@index([visitorId])
}

model article_persons {
  articleId String
  personId  String
  articles  articles @relation(fields: [articleId], references: [id], onDelete: Cascade)
  persons   persons  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([articleId, personId])
}

model article_qa {
  id            String   @id
  articleId     String   @unique
  questions     Json
  schemaEnabled Boolean  @default(true)
  generatedAt   DateTime @default(now())
  updatedAt     DateTime
  headingType   String?  @default("default")
  articles      articles @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model article_series {
  articleId String
  seriesId  Int
  position  Int      @default(0)
  createdAt DateTime @default(now())
  articles  articles @relation(fields: [articleId], references: [id], onDelete: Cascade)
  series    series   @relation(fields: [seriesId], references: [tmdbId], onDelete: Cascade)

  @@id([articleId, seriesId])
  @@index([articleId])
  @@index([seriesId])
}

model articles {
  id                        String                      @id
  slug                      String                      @unique
  title                     String
  excerpt                   String?
  contentHtml               String
  heroLocalUrl              String?
  heroVideoUrl              String?
  tmdbId                    Int?
  tmdbType                  String                      @default("tv")
  tmdbBackdropPath          String?
  tmdbPosterPath            String?
  heroImageUrl              String?
  ogImageUrl                String?
  cardImageUrl              String?
  imageAttribution          String                      @default("TMDB")
  streamer                  String?
  category                  String?
  tags                      String[]
  authorId                  String
  publishedAt               DateTime?
  updatedAt                 DateTime
  createdAt                 DateTime                    @default(now())
  status                    String                      @default("draft")
  readingTime               Int?
  confidence                Float?
  sourceUrl                 String?                     @unique
  sourcePublishedAt         DateTime?
  contentType               String?
  primarySeriesId           Int?
  publishMode               String                      @default("DISCOVER")
  wasBedeutetDasText        String?
  darumRelevantText         String?
  bisherigerStandText       String?
  trailerLocalUrl           String?
  cardImagePath             String?
  heroImagePath             String?
  isRankingArticle          Boolean                     @default(false)
  metaDescription           String?
  ogImagePath               String?
  isBreaking                Boolean                     @default(false)
  isTrending                Boolean                     @default(false)
  article_persons           article_persons[]
  article_qa                article_qa?
  article_series            article_series[]
  users                     users                       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  series                    series?                     @relation(fields: [primarySeriesId], references: [tmdbId])
  comments                  comments[]
  discover_audits           discover_audits?
  discover_score_dashboards discover_score_dashboards[]
  headline_comparisons      headline_comparisons?

  @@index([primarySeriesId])
  @@index([publishedAt])
  @@index([slug])
}

model characters {
  id                  String   @id
  slug                String   @unique
  name                String
  seriesTmdbId        Int
  tmdbCharacterId     String?
  actorTmdbId         Int?
  shortDescription    String?
  whoIsContent        String?
  roleInSeriesContent String?
  importanceContent   String?
  appearancesContent  String?
  qaContent           Json?
  status              String?
  firstAppearance     String?
  seasons             String?
  metaTitle           String?
  metaDescription     String?
  publishStatus       String   @default("draft")
  articleMentions     Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime
  imageUrl            String?
  orderIndex          Int?
  persons             persons? @relation(fields: [actorTmdbId], references: [tmdbId])
  series              series   @relation(fields: [seriesTmdbId], references: [tmdbId], onDelete: Cascade)

  @@index([actorTmdbId])
  @@index([seriesTmdbId])
  @@index([slug])
}

model comments {
  id             String     @id
  articleId      String
  userId         String
  parentId       String?
  content        String
  status         String     @default("pending")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  articles       articles   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  comments       comments?  @relation("commentsTocomments", fields: [parentId], references: [id], onDelete: Cascade)
  other_comments comments[] @relation("commentsTocomments")
  users          users      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model discover_audits {
  id             String   @id
  articleId      String   @unique
  discoverScore  Int
  discoverMode   String
  passed         Boolean
  breakdownJson  Json
  wordCount      Int
  hasHero        Boolean
  hasByline      Boolean
  freshnessHours Int
  aiRiskScore    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  articles       articles @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([discoverScore])
  @@index([passed])
}

model discover_score_dashboards {
  id               String   @id
  articleId        String
  timestamp        DateTime @default(now())
  pipelineVersion  String   @default("serien_pipeline_v1")
  headlineMetrics  Json
  contentMetrics   Json
  freshnessMetrics Json
  imageMetrics     Json
  trustMetrics     Json
  discoverScore    Float
  finalVerdict     String
  primaryBlockers  String[]
  improvementHints String[]
  articles         articles @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([timestamp])
}

model error_logs {
  id        String   @id
  type      String
  path      String
  referrer  String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([type])
}

model follows {
  userId       String
  tmdbSeriesId Int
  createdAt    DateTime @default(now())
  series       series   @relation(fields: [tmdbSeriesId], references: [tmdbId], onDelete: Cascade)
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tmdbSeriesId])
}

model headline_comparisons {
  id                    String   @id
  articleId             String   @unique
  headline_original     String
  headline_rewritten    String?
  antiAiScore_original  Int?
  antiAiScore_rewritten Int?
  headline_delta        Int?
  status                String   @default("NO_REWRITE")
  createdAt             DateTime @default(now())
  articles              articles @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([createdAt])
  @@index([status])
}

model notifications {
  id          String   @id
  userId      String
  type        String
  entityId    String
  payloadJson Json?
  seen        Boolean  @default(false)
  createdAt   DateTime @default(now())
  users       users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seen])
}

model persons {
  id               String            @id
  tmdbId           Int               @unique
  slug             String            @unique
  name             String
  biography        String?
  profilePath      String?
  knownFor         String?
  birthDate        DateTime?
  birthPlace       String?
  popularity       Float?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  localProfilePath String?
  article_persons  article_persons[]
  characters       characters[]
}

model pipeline_runs {
  id             String    @id
  pipeline       String
  trigger        String
  status         String
  inputQuery     String?
  inputVideoId   String?
  inputSource    String?
  articleId      String?
  articleSlug    String?
  articleTitle   String?
  sourcesFound   Int       @default(0)
  wordsCollected Int       @default(0)
  factsExtracted Int       @default(0)
  antiAiScore    Int?
  durationMs     Int?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  errorMessage   String?
  errorStep      String?
  debugLog       String?
  metadata       String?
  createdAt      DateTime  @default(now())

  @@index([articleId])
  @@index([pipeline])
  @@index([startedAt])
  @@index([status])
}

model push_subscriptions {
  id        String   @id
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model redirects {
  fromPath  String   @id @unique
  toPath    String
  type      Int      @default(301)
  createdAt DateTime @default(now())
}

model series {
  tmdbId              Int                 @id @unique
  title               String
  slug                String              @unique
  overview            String?
  posterLocalUrl      String?
  backdropLocalUrl    String?
  status              String?
  firstAirDate        DateTime?
  genres              String[]
  networks            String[]
  tmdbData            Json?
  updatedAt           DateTime
  createdAt           DateTime            @default(now())
  backdropPath        String?
  genresJson          Json?
  name                String?
  networksJson        Json?
  originalName        String?
  posterPath          String?
  tmdbType            String              @default("tv")
  cast                Json?
  crew                Json?
  episodeRunTime      Int[]
  inProduction        Boolean?
  keywords            String[]
  lastAirDate         DateTime?
  numberOfEpisodes    Int?
  numberOfSeasons     Int?
  originalLanguage    String?
  popularity          Float?
  productionCompanies String[]
  productionCountries String[]
  seasons             Json?
  spokenLanguages     String[]
  tagline             String?
  trailers            Json?
  type                String?
  voteAverage         Float?
  voteCount           Int?
  currentStatus       String?
  lastNewsDate        DateTime?
  lastSeasonNumber    Int?
  statusDescription   String?
  statusLastUpdate    DateTime?
  extendedOverview    String?
  discoverIntro       String?
  discoverNewsContext String?
  discoverQA          Json?
  discoverStatus      String?
  backdrops           Json?
  localTrailerPath    String?
  article_series      article_series[]
  articles            articles[]
  characters          characters[]
  follows             follows[]
  upcoming_episodes   upcoming_episodes[]
}

model streaming_releases {
  id           String    @id
  tmdbId       Int
  provider     String
  date         DateTime  @db.Date
  name         String
  overview     String?
  posterPath   String?
  backdropPath String?
  firstAirDate DateTime?
  voteAverage  Float?
  releaseType  String    @default("new_episode")
  fetchedAt    DateTime  @default(now())

  @@unique([tmdbId, provider, date])
  @@index([date])
  @@index([provider])
}

model trending_topics {
  id           String    @id
  query        String
  title        String
  category     String
  growth       String?
  tmdbId       Int?
  seriesSlug   String?
  articleSlugs String[]
  date         DateTime
  fetchedAt    DateTime  @default(now())
  processed    Boolean   @default(false)
  articleId    String?
  processedAt  DateTime?

  @@unique([query, date])
  @@index([category])
  @@index([date])
  @@index([processed])
}

model upcoming_episodes {
  id            String   @id
  seriesId      Int
  seriesName    String
  seriesSlug    String
  seasonNumber  Int
  episodeNumber Int
  episodeName   String?
  airDate       DateTime
  overview      String?
  stillPath     String?
  network       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  series        series   @relation(fields: [seriesId], references: [tmdbId], onDelete: Cascade)

  @@unique([seriesId, seasonNumber, episodeNumber])
  @@index([airDate])
  @@index([network])
}

model users {
  id                  String          @id
  name                String?
  email               String          @unique
  password            String?
  createdAt           DateTime        @default(now())
  image               String?
  role                String          @default("user")
  favoriteStreamers   String[]        @default([])
  onboardingCompleted Boolean         @default(false)
  bio                 String?
  expertise           String[]        @default([])
  articles            articles[]
  comments            comments[]
  follows             follows[]
  notifications       notifications[]
}

model video_download_queue {
  id          String    @id
  articleId   String    @unique
  seriesName  String
  youtubeId   String
  status      String    @default("pending")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  resultPath  String?
  priority    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  completedAt DateTime?

  @@index([createdAt])
  @@index([priority])
  @@index([status])
}

model youtube_channels {
  id              String           @id
  channelId       String           @unique
  name            String
  url             String
  thumbnailUrl    String?
  description     String?
  subscriberCount Int?
  isActive        Boolean          @default(true)
  checkInterval   Int              @default(60)
  lastCheckedAt   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  youtube_videos  youtube_videos[]

  @@index([isActive])
  @@index([lastCheckedAt])
}

model youtube_videos {
  id               String           @id
  videoId          String           @unique
  channelId        String
  title            String
  description      String?
  thumbnailUrl     String?
  duration         String?
  publishedAt      DateTime
  viewCount        Int?
  likeCount        Int?
  processed        Boolean          @default(false)
  processedAt      DateTime?
  articleId        String?
  articleSlug      String?
  transcript       String?
  tags             String[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  youtube_channels youtube_channels @relation(fields: [channelId], references: [channelId], onDelete: Cascade)

  @@index([channelId])
  @@index([processed])
  @@index([publishedAt])
}
