  label          String
  tmdbIds        Int[]    @default([])
  urlPatterns    String[] @default([])
  titleKeywords  String[] @default([])
  enabled        Boolean  @default(true)
  hits           Int      @default(0)
  lastHitAt      DateTime?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enabled])
}

